      "note": "soft6 byte idea on cheaper LSTM"
    },
    {
      "name": "soft6_l288",
      "extra_defs": [
        "-DFXCM_LSTM_HIDDEN=288",
        "-DFXCM_SPEED_LSTM_MATCH_SKIP_SOFT",
        "-DFXCM_SPEED_MATCH_SKIP_MIN=6u"
      ],
      "note": "soft6 near-320"
    },
    {
      "name": "soft6_l320",
      "extra_defs": [
        "-DFXCM_LSTM_HIDDEN=320",
        "-DFXCM_SPEED_LSTM_MATCH_SKIP_SOFT",
        "-DFXCM_SPEED_MATCH_SKIP_MIN=6u"
      ],
      "note": "soft6 on banked size — keep 320 wall class?"
    },
    {
      "name": "soft6_l384",
      "extra_defs": [
        "-DFXCM_LSTM_HIDDEN=384",
        "-DFXCM_SPEED_LSTM_MATCH_SKIP_SOFT",
        "-DFXCM_SPEED_MATCH_SKIP_MIN=6u"
      ],
      "note": "alias of softskip6 — ref max-bytes arm"
    }
  ]
