#!/usr/bin/env bash
# Open .fzsx / .fzsxsd / .fzsd with PHP CLI (extract beside archive). Used by Linux/macOS file association.
set -euo pipefail
if [[ $# -lt 1 ]]; then
	echo "Usage: fzsx-open /path/to/file.fzsx|.fzsxsd|.fzsd" >&2
	exit 1
fi
ARCHIVE="$(realpath "$1" 2>/dev/null || echo "$1")"
if [[ ! -f "$ARCHIVE" ]]; then
	echo "Not a file: $ARCHIVE" >&2
	exit 1
fi
PHP_BIN="${PHP_BIN:-php}"
if ! command -v "$PHP_BIN" >/dev/null 2>&1; then
	echo "php not found on PATH; set PHP_BIN or install PHP CLI." >&2
	exit 127
fi
exec "$PHP_BIN" "$ARCHIVE"
